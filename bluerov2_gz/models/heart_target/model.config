<?xml version="1.0"?>
<model>
  <name>heart_target</name>
  <version>1.0</version>
  <sdf version="1.7">model.sdf</sdf>
  <description>
    Torpedo target plate for the SAVe arena: a 0.61 m square with a
    0.34 x 0.31 m heart-shaped hole through it. Only the mesh is used -
    save_arena.sdf references meshes/heart_plate.obj directly for both
    visual and collision, so the cutout is a real hole in the physics and
    a torpedo can pass through it.

    Regenerate with make_heart_plate.py.
  </description>
</model>
