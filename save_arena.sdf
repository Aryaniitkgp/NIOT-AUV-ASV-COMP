        </material>
      </visual>
    </link>
    <!-- Torpedo targets: two 0.61 m plates, each with a real heart-shaped
         hole through it. The hole is a mesh, not a primitive, because SDF
         cannot subtract one shape from another - see
         bluerov2_gz/models/heart_target/make_heart_plate.py.

         The mesh is VISUAL ONLY. dartsim cannot build a collision shape
         from an SDF mesh ("Mesh construction from an SDF has not been
         implemented yet for dartsim"), and feeding it one crashes the
         simulator outright in OdeMesh::fillArrays.

         So collision is four boxes forming a frame around the heart's
         bounding box, leaving a 0.34 x 0.307 m opening. A torpedo through
         the middle passes; one that hits the plate stops. The opening is
         rectangular rather than heart-shaped, so the corners are slightly
         forgiving - scoring "through the heart" precisely needs the
         geometric check against the real outline, not physics alone.

         Originally these were solid boxes at y=3.85 and y=4.15: only
         0.30 m apart while each was 0.61 m wide, so they intersected each
         other over 0.31 m in a shared plane. Now at +/-0.35 about the
         pipe, leaving a 0.09 m gap. -->
    <link name="cupid_red">
      <pose>4.0000 3.6500 1.3000 0.0000 0.0000 1.5708</pose>
      <collision name="cupid_red_l"><pose>-0.2375 0 0 0 0 0</pose>
        <geometry><box><size>0.135 0.02 0.61</size></box></geometry></collision>
      <collision name="cupid_red_r"><pose>0.2375 0 0 0 0 0</pose>
        <geometry><box><size>0.135 0.02 0.61</size></box></geometry></collision>
      <collision name="cupid_red_t"><pose>0 0 0.22925 0 0 0</pose>
        <geometry><box><size>0.34 0.02 0.1515</size></box></geometry></collision>
      <collision name="cupid_red_b"><pose>0 0 -0.22925 0 0 0</pose>
        <geometry><box><size>0.34 0.02 0.1515</size></box></geometry></collision>
      <visual name="cupid_red_vis">
        <geometry><mesh><uri>model://heart_target/meshes/heart_plate.obj</uri></mesh></geometry>
        <material>
          <ambient>0.85 0.1 0.1 1.0</ambient>
          <diffuse>0.85 0.1 0.1 1.0</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
    <link name="cupid_green">
      <pose>4.0000 4.3500 1.3000 0.0000 0.0000 1.5708</pose>
      <collision name="cupid_green_l"><pose>-0.2375 0 0 0 0 0</pose>
        <geometry><box><size>0.135 0.02 0.61</size></box></geometry></collision>
      <collision name="cupid_green_r"><pose>0.2375 0 0 0 0 0</pose>
        <geometry><box><size>0.135 0.02 0.61</size></box></geometry></collision>
      <collision name="cupid_green_t"><pose>0 0 0.22925 0 0 0</pose>
