  <!-- Obstacle crossing: "L" shaped PVC bar, which the AUV has to pass
       over (see the competition brief, route section (a)).

       The L stands UPRIGHT, in the y-z plane at x = -4.0, so it reads as
       an L from the front camera as the vehicle approaches down the path
       - one rod parallel to the ground, one perpendicular to it:

           z=1.7    |                     ll_short, vertical
                    |
                    |
           z=0.5    +==============       ll_long, horizontal crossbar
                 y=1.5           y=-0.3

       Body +y is to port, and the front camera's image right is -y, so
       the vertical stroke at y = +1.5 lands on the left of the image and
       the foot runs off to the right: a correctly oriented "L" from the
       vehicle's point of view.

       The crossbar spans the path (which is at y = 0) at z = 0.5, and
       that is the rod the vehicle must clear. The vertical rod is well
       out to port so it marks the obstacle without blocking the lane. -->
  <model name="love_lane">
    <static>true</static>
    <link name="ll_a_base">
      <pose>-4.0000 -0.3000 0.0200 0.0000 0.0000 0.0000</pose>
      <collision name="ll_a_base_col">
        <geometry><cylinder><radius>0.1</radius><length>0.04</length></cylinder></geometry>
      </collision>
      <visual name="ll_a_base_vis">
        <geometry><cylinder><radius>0.1</radius><length>0.04</length></cylinder></geometry>
        <material>
          <ambient>0.28 0.28 0.3 1.0</ambient>
          <diffuse>0.28 0.28 0.3 1.0</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
    <link name="ll_a_pipe">
      <pose>-4.0000 -0.3000 0.2500 0.0000 0.0000 0.0000</pose>
      <collision name="ll_a_pipe_col">
        <geometry><cylinder><radius>0.03</radius><length>0.5</length></cylinder></geometry>
      </collision>
      <visual name="ll_a_pipe_vis">
        <geometry><cylinder><radius>0.03</radius><length>0.5</length></cylinder></geometry>
        <material>
          <ambient>0.6 0.6 0.62 1.0</ambient>
          <diffuse>0.6 0.6 0.62 1.0</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
    <link name="ll_b_base">
      <pose>-4.0000 1.5000 0.0200 0.0000 0.0000 0.0000</pose>
      <collision name="ll_b_base_col">
        <geometry><cylinder><radius>0.1</radius><length>0.04</length></cylinder></geometry>
      </collision>
      <visual name="ll_b_base_vis">
        <geometry><cylinder><radius>0.1</radius><length>0.04</length></cylinder></geometry>
        <material>
          <ambient>0.28 0.28 0.3 1.0</ambient>
          <diffuse>0.28 0.28 0.3 1.0</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
    <link name="ll_b_pipe">
      <pose>-4.0000 1.5000 0.2500 0.0000 0.0000 0.0000</pose>
      <collision name="ll_b_pipe_col">
        <geometry><cylinder><radius>0.03</radius><length>0.5</length></cylinder></geometry>
      </collision>
      <visual name="ll_b_pipe_vis">
        <geometry><cylinder><radius>0.03</radius><length>0.5</length></cylinder></geometry>
        <material>
          <ambient>0.6 0.6 0.62 1.0</ambient>
          <diffuse>0.6 0.6 0.62 1.0</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>

    <!-- Horizontal rod: parallel to the ground, crossing the path at
         z = 0.5. This is the one the vehicle passes over.

         Blue so the crossing task has something to segment on.
         Saturation separates it from the grey floor (S~227 vs ~70
         through the water tint) and value separates it from the navy
         bins (V~218 vs ~137); the orange path is a different hue
         entirely. The grey supports stay grey so only the L itself
         shows up in the blue mask. -->
    <link name="ll_long">
      <pose>-4.0000 0.6000 0.5000 1.5708 0.0000 0.0000</pose>
      <collision name="ll_long_col">
        <geometry><cylinder><radius>0.03</radius><length>1.8</length></cylinder></geometry>
      </collision>
      <visual name="ll_long_vis">
        <geometry><cylinder><radius>0.03</radius><length>1.8</length></cylinder></geometry>
        <material>
          <ambient>0.05 0.1 0.9 1.0</ambient>
          <diffuse>0.05 0.1 0.9 1.0</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>

    <!-- Vertical rod: perpendicular to the ground, rising from the port
         end of the crossbar. No rotation - a cylinder's own axis is
         already z. -->
    <link name="ll_short">
      <pose>-4.0000 1.5000 1.1000 0.0000 0.0000 0.0000</pose>
      <collision name="ll_short_col">
        <geometry><cylinder><radius>0.03</radius><length>1.2</length></cylinder></geometry>
      </collision>
      <visual name="ll_short_vis">
        <geometry><cylinder><radius>0.03</radius><length>1.2</length></cylinder></geometry>
        <material>
          <ambient>0.05 0.1 0.9 1.0</ambient>
          <diffuse>0.05 0.1 0.9 1.0</diffuse>
