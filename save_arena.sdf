      </collision>
      <visual name="wall_xn_vis">
        <geometry><box><size>0.2 20.4 2.8</size></box></geometry>
        <material>
          <ambient>0.6 0.6 0.62 1.0</ambient>
          <diffuse>0.6 0.6 0.62 1.0</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
    <link name="wall_yp">
      <pose>0.0000 10.1000 1.4000 0 0 0.0000</pose>
      <collision name="wall_yp_col">
        <geometry><box><size>25.0 0.2 2.8</size></box></geometry>
      </collision>
      <visual name="wall_yp_vis">
        <geometry><box><size>25.0 0.2 2.8</size></box></geometry>
        <material>
          <ambient>0.6 0.6 0.62 1.0</ambient>
          <diffuse>0.6 0.6 0.62 1.0</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
    <link name="wall_yn">
      <pose>0.0000 -10.1000 1.4000 0 0 0.0000</pose>
      <collision name="wall_yn_col">
        <geometry><box><size>25.0 0.2 2.8</size></box></geometry>
